package Cep;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.util.Scanner;

public class ConsultaCep {

	public static void main(String[] args) {

		System.out.println("RICARDO LORRAN FREIRE SANTOS - RA 0025400");

		Scanner leitor = new Scanner(System.in);
		System.out.print("Digite o CEP: ");
		String cep = leitor.nextLine().replaceAll("[^0-9]", ""); // TIRA TRAÇO, PONTO E ESPAÇO
		leitor.close();

		if (cep.length() != 8) {
			System.out.println("CEP inválido. O CEP precisa ter 8 números.");
			return;
		}

		String url = "https://viacep.com.br/ws/" + cep + "/json/";

		try {

			HttpClient client = HttpClient.newHttpClient();
			HttpRequest request = HttpRequest.newBuilder()
					.uri(URI.create(url)) // INFORMA O ENDEREÇO PARA CONSULTA
					.GET() // PEDE OS DADOS DO SITE
					.build(); // FINALIZA A CONSULTA

			HttpResponse<String> response = client.send(
					request,
					HttpResponse.BodyHandlers.ofString()
			);

			// MOSTRA O RESULTADO DA CONSULTA
			if (response.statusCode() == 200 && !response.body().contains("\"erro\"")) {
				System.out.println("Consulta do CEP " + cep + ":");
				System.out.println(response.body());
			} else {
				System.out.println("CEP não encontrado: " + cep);
			}

		} catch (Exception e) {

			System.out.println("Erro ao consultar o CEP: " + e.getMessage());

		}

	}

}
